# Copy to .env; this file contains no credentials.
ENVIRONMENT=development
APP_ORIGIN=http://localhost:8000
PUBLIC_API_ORIGIN=http://localhost:8000
DATABASE_URL=postgresql://coastworks:local-only@localhost:55432/coastworks
SECRET_KEY=development-only-change-before-deploy-0123456789
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
EMBEDDINGS_PROVIDER=gemini
EMBEDDINGS_MODEL=gemini-embedding-001
GEMINI_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_STARTTLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=Coastworks <hello@localhost>
GLOBAL_CRAWLS_PER_DAY=100
GLOBAL_MESSAGES_PER_DAY=2000

# Preview stays small. Published bots queue a full rebuild while serving the old index.
CRAWL_PAGES=8
CRAWL_SECONDS=110
KNOWLEDGE_PAGES=500
KNOWLEDGE_SECONDS=1200
KNOWLEDGE_CHUNKS=12000
PREVIEW_CHUNKS=300
EMBEDDING_BATCH_SIZE=64
RETRIEVAL_CANDIDATES=32
RERANK_CANDIDATES=24
ANSWER_CHUNKS=8
RAG_MAX_TOKENS=2400
# Gemini 2.5 Flash: a small reasoning budget improved scope/reranking in evals.
# For other Gemini models use a supported budget (-1 means dynamic thinking).
RAG_THINKING_BUDGET=256
## Billing: enable after configuring Checkout, portal, signed webhook and tax.
BILLING_ENABLED=false
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_PORTAL_CONFIGURATION_ID=
STRIPE_LIVEMODE=false
# Must match the recurring Price (39900 SEK minor units, interval month, quantity 1).
STRIPE_TAX_BEHAVIOR=inclusive
# Enable only after verifying active Stripe Tax registrations.
STRIPE_AUTOMATIC_TAX=false
